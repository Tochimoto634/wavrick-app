# Wavrick 静的サイト（依頼フォーム / app.js）
# Railway サービス wavrick-app-production 用
# Settings → Build → Dockerfile path: Dockerfile.railway-frontend
FROM nginx:1.27-alpine

COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY index.html app.js styles.css record-workspace.css record-booth.css ./
COPY record-workspace.html record-booth.html oauth-done.html wavrick-share.html ./
COPY js/ ./js/

EXPOSE 8080

