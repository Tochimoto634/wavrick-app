# Wavrick 静的サイト（依頼フォーム / app.js）
# Railway サービス cozy-smile / wavrick-app-production 用
FROM nginx:1.27-alpine

COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY index.html app.js styles.css record-workspace.css record-booth.css /usr/share/nginx/html/
COPY record-workspace.html record-booth.html oauth-done.html wavrick-share.html /usr/share/nginx/html/
COPY js/ /usr/share/nginx/html/js/

EXPOSE 8080
CMD sh -c 'sed -i "s/listen 8080/listen ${PORT:-8080}/" /etc/nginx/conf.d/default.conf && exec nginx -g "daemon off;"'
