# Railway: deploy from repo root when Root Directory UI is unavailable.
# Settings → Build → Dockerfile path: Dockerfile.railway-audio-proxy
FROM node:20-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    python3 python3-pip \
    ffmpeg ca-certificates curl git unzip \
    python3 make g++ pkg-config libvips-dev \
    libvips42 libcairo2 libpango-1.0-0 libjpeg62-turbo libgif7 librsvg2-2 \
  && curl -fsSL https://deno.land/install.sh | sh \
  && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.deno/bin:/usr/local/bin:${PATH}"
ENV WAVRICK_YT_REMOTE_COMPONENTS=ejs:github

ARG BGUTIL_VERSION=1.3.2
RUN git clone --depth 1 --branch "${BGUTIL_VERSION}" \
    https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git /opt/bgutil \
  && cd /opt/bgutil/server \
  && npm ci \
  && npx tsc \
  && test -f /opt/bgutil/server/build/main.js

WORKDIR /app
COPY services/youtube-audio-proxy/requirements-railway.txt requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

COPY services/youtube-audio-proxy/app.py \
     services/youtube-audio-proxy/cors_utils.py \
     services/youtube-audio-proxy/rate_limit.py \
     services/youtube-audio-proxy/run_demucs.py \
     services/youtube-audio-proxy/lang_tracks.py \
     services/youtube-audio-proxy/start-railway.sh \
     ./
RUN chmod +x /app/start-railway.sh

ENV WAVRICK_VOCAL_SEPARATION=0
ENV WAVRICK_YT_POT_ENABLED=1
ENV WAVRICK_YT_POT_PORT=4416
ENV WAVRICK_YT_POT_SERVER_HOME=/opt/bgutil/server
ENV WAVRICK_NODE_PATH=/usr/local/bin/node

CMD ["/app/start-railway.sh"]
