FROM node:20-bookworm-slim AS bgutil-build

RUN apt-get update \
  && apt-get install -y --no-install-recommends git python3 make g++ pkg-config libvips-dev \
  && rm -rf /var/lib/apt/lists/*

ARG BGUTIL_VERSION=1.3.2
RUN git clone --depth 1 --branch "${BGUTIL_VERSION}" \
    https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git /opt/bgutil \
  && cd /opt/bgutil/server \
  && npm ci \
  && npx tsc

FROM python:3.12-slim-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=node:20-bookworm-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=bgutil-build /opt/bgutil /opt/bgutil

WORKDIR /app
COPY requirements-railway.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py cors_utils.py rate_limit.py run_demucs.py lang_tracks.py ./
COPY start-railway.sh /start-railway.sh
RUN chmod +x /start-railway.sh

ENV WAVRICK_VOCAL_SEPARATION=0
ENV WAVRICK_YT_POT_ENABLED=1
ENV WAVRICK_YT_POT_PORT=4416

CMD ["/start-railway.sh"]
