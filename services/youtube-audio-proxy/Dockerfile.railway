FROM python:3.12-slim-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates nodejs \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-railway.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py cors_utils.py rate_limit.py run_demucs.py ./

ENV WAVRICK_VOCAL_SEPARATION=0

CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT:-8080} --workers 1 --timeout 300 app:app"]
