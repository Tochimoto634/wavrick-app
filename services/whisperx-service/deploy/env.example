# WhisperX サーバー用（deploy/.env にコピーして編集）
PORT=8081

# 必須（Mac の .local/secrets.env / Supabase secrets と同じ値）
WHISPERX_SERVICE_SECRET=change-me-to-long-random-string

# GPU サーバー（推奨）
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
WHISPERX_MODEL=large-v3
WHISPERX_BATCH_SIZE=16

# CPU のみの場合
# WHISPERX_DEVICE=cpu
# WHISPERX_COMPUTE_TYPE=int8
# WHISPERX_BATCH_SIZE=8

WHISPERX_MAX_BYTES=25165824

# JSON audioUrl 利用時のみ（Supabase Storage 等）
# WHISPERX_ALLOWED_AUDIO_HOSTS=your-project.supabase.co
